# Database — individual vars (native Windows install)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cbuser
DB_PASSWORD=your_strong_password
DB_NAME=customer_balance_db

# OR use a single connection string instead of the above (Docker / cloud)
# DATABASE_URL=postgresql://cbuser:your_strong_password@localhost:5432/customer_balance_db

# App
JWT_SECRET=your_64_char_random_string_here
NODE_ENV=production
PORT=3000
UPLOAD_DIR=C:/apps/Taryah-WB/backend/uploads

# Optional
# DB_SSL=true
# CORS_ORIGIN=https://www.sales.taryahpoultry.com.sa
